# =============================================================================
# LMS FULL-STACK ENVIRONMENT CONFIGURATION
# =============================================================================

# Server Environment
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL with Connection Pooling)
# DATABASE_URL: Pooler endpoint (e.g. Supabase port 6543 / PgBouncer / Neon)
DATABASE_URL=postgresql://lms:lms_dev_only@localhost:5432/lms?schema=public
# DIRECT_URL: Direct PostgreSQL connection for migrations (port 5432)
DIRECT_URL=postgresql://lms:lms_dev_only@localhost:5432/lms?schema=public

# Security & Secrets (Must be at least 32 characters in production)
JWT_ACCESS_SECRET=your_dev_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_dev_jwt_refresh_secret_min_32_characters_long
REPORT_CARD_SIGNING_SECRET=your_dev_report_card_signing_secret_min_32_chars
COUNSELING_ENCRYPTION_SECRET=your_dev_counseling_encryption_secret_min_32_chars
FINANCE_ENCRYPTION_SECRET=your_dev_finance_encryption_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Allowed Origins (Comma-separated for multiple origins / Vercel preview domains)
CLIENT_URL=http://localhost:5173,https://your-lms-domain.vercel.app

# Storage Configuration
# Options: LOCAL, VERCEL_BLOB, S3
STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Vercel Blob (Required only if STORAGE_PROVIDER=VERCEL_BLOB)
# BLOB_READ_WRITE_TOKEN=vercel_blob_rw_...

# AWS S3 / Cloudflare R2 (Required only if STORAGE_PROVIDER=S3)
# S3_BUCKET=my-lms-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=...
# S3_SECRET_ACCESS_KEY=...
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com

# Redis / Rate Limiting (Optional - falls back to memory if false or unreachable)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# Logging
LOG_LEVEL=info
