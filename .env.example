# Server Environment Variables (Development Defaults)
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

# Database Configuration (PostgreSQL 16)
DATABASE_URL=postgresql://lms:lms_dev_only@localhost:5432/lms?schema=public

# Security & JWT Tokens (Replace with strong random strings in production)
JWT_ACCESS_SECRET=your_jwt_access_secret_min_32_chars_long
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long
REPORT_CARD_SIGNING_SECRET=your_report_card_signing_secret_min_32_chars_long
COUNSELING_ENCRYPTION_SECRET=your_counseling_encryption_secret_min_32_chars_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# CORS Configuration
CLIENT_URL=http://localhost:5173

# Local File Uploads
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

# Logging
LOG_LEVEL=debug
