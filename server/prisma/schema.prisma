model BookCopy {
  id        String   @id @default(uuid())
  bookId    String
  barcode   String   @unique
  status    String   @default("AVAILABLE")
  createdAt DateTime @default(now())
  book      BookCatalog @relation(fields: [bookId], references: [id], onDelete: Cascade)
  loans     BookBorrowRecord[]
  reservations LibraryReservation[]
  @@index([bookId, status])
  @@map("book_copies")
}
model LibraryFinePolicy {
  id              String   @id @default(uuid())
  institutionId   String   @unique
  dailyFine       Decimal  @db.Decimal(10, 2)
  currencyCode    String   @default("PKR") @db.VarChar(3)
  updatedByUserId String
  updatedAt       DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@map("library_fine_policies")
}

model BookBorrowRecord {
  id             String       @id @default(uuid())
  bookId         String
  copyId         String?
  studentId      String
  borrowedAt     DateTime     @default(now())
  dueDate        DateTime
  returnedAt     DateTime?
  fineAmount     Decimal      @default(0.00) @db.Decimal(10, 2)
  status         BorrowStatus @default(BORROWED)
  issuedByUserId String
  lostReportedAt DateTime?
  recoveredAt    DateTime?
  renewalCount   Int          @default(0)

  book    BookCatalog    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  copy    BookCopy?      @relation(fields: [copyId], references: [id], onDelete: SetNull)
