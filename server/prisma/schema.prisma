  @@map("hostel_gate_passes")
}

model HostelVisitorLog {
  id            String    @id @default(uuid())
  institutionId String
  studentId     String?
  visitorName   String
  purpose       String
  enteredAt     DateTime  @default(now())
  exitedAt      DateTime?
  loggedByUserId String

  institution Institution       @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     StudentProfile?   @relation(fields: [studentId], references: [id], onDelete: SetNull)

  @@index([institutionId, enteredAt])
  @@map("hostel_visitor_logs")
}

model HostelMessCharge {
  id            String             @id @default(uuid())
  institutionId String
  studentId     String
  period        String             @db.VarChar(7)
  amount        Decimal            @db.Decimal(12, 2)
  currencyCode  String             @db.VarChar(3)
  status        HostelChargeStatus @default(UNPAID)
