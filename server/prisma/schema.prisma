  createdByUserId String
  createdAt       DateTime @default(now())

  supportPlan CounselingSupportPlan @relation(fields: [supportPlanId], references: [id], onDelete: Cascade)

  @@index([supportPlanId, dueAt])
  @@map("counseling_follow_ups")
}

model CounselingReferral {
  id              String                  @id @default(uuid())
  institutionId   String
  studentId       String
  referredByUserId String
  reason          String?
  encryptedReason String?
  status          CounselingReferralStatus @default(PENDING)
  reviewedByUserId String?
  reviewedAt      DateTime?
  createdAt       DateTime                @default(now())

  institution Institution    @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([institutionId, status, createdAt])
  @@map("counseling_referrals")
}

model CounselingAtRiskRule {
  id                  String   @id @default(uuid())
  institutionId       String
  name                String
  minimumAbsences     Int
  lookbackDays        Int
  minimumGradePercent Float?
  isActive            Boolean  @default(true)
  updatedByUserId     String
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)

  @@unique([institutionId, name])
  @@map("counseling_at_risk_rules")
}

// -------------------------------------------------------------
// 9. COMMUNICATION & AUDIT INFRASTRUCTURE
// -------------------------------------------------------------

model Announcement {
  id            String   @id @default(uuid())
  institutionId String
  authorUserId  String
  title         String
  content       String
  targetRole    String? // Null = Everyone, or specific role
  isPinned      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  author      User        @relation(fields: [authorUserId], references: [id], onDelete: Cascade)

  @@index([institutionId, targetRole])
  @@map("announcements")
}

model DirectMessage {
  id         String    @id @default(uuid())
  senderId   String
  receiverId String
  subject    String?
  body       String
  isRead     Boolean   @default(false)
  readAt     DateTime?
  createdAt  DateTime  @default(now())

  sender   User @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)

  @@index([senderId, receiverId])
  @@map("direct_messages")
}

model Notification {
  id            String   @id @default(uuid())
  institutionId String
  userId        String
  title         String
  message       String
  type          String   @default("INFO") // INFO, WARNING, ALERT, SUCCESS
  linkUrl       String?
  isRead        Boolean  @default(false)
  createdAt     DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@map("notifications")
}

model AuditEvent {
  id            String   @id @default(uuid())
  institutionId String? // Null for platform super admin actions
  userId        String? // Null for system events
  action        String // e.g. "USER_LOGIN", "GRADE_CHANGED", "FEE_WAIVER_APPROVED"
  entity        String // e.g. "ExamMark", "FeeWaiverRequest", "User"
  entityId      String?
  oldValuesJson String?
  newValuesJson String?
  ipAddress     String?
  userAgent     String?
  timestamp     DateTime @default(now())

  institution Institution? @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  user        User?        @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([institutionId, entity, action, timestamp])
  @@map("audit_events")
}
