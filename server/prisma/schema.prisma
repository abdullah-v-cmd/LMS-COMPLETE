  @@map("book_borrow_records")
}

model LibraryReservation {
  id             String   @id @default(uuid())
  institutionId  String
  bookId         String
  studentId      String
  status         String   @default("QUEUED")
  queuePosition  Int
  assignedCopyId String?
  requestedAt    DateTime @default(now())
  updatedAt      DateTime @updatedAt
  fulfilledAt    DateTime?
  cancelledAt    DateTime?
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  book        BookCatalog @relation(fields: [bookId], references: [id], onDelete: Cascade)
  student     StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  assignedCopy BookCopy? @relation(fields: [assignedCopyId], references: [id], onDelete: SetNull)
  @@index([institutionId, bookId, status, queuePosition])
  @@index([studentId, bookId, status])
  @@map("library_reservations")
}

model LibraryInventoryAudit {
  id                String   @id @default(uuid())
  institutionId     String
  bookId            String
  performedByUserId String
  expectedCount     Int
  scannedCount      Int
  missingBarcodes   String[] @default([])
  unexpectedBarcodes String[] @default([])
  createdAt         DateTime @default(now())
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  book        BookCatalog @relation(fields: [bookId], references: [id], onDelete: Cascade)
  @@index([institutionId, bookId, createdAt])
  @@map("library_inventory_audits")
}

model TransportRoute {
  id            String   @id @default(uuid())
  institutionId String
  name          String // e.g. "Route 4 - North Suburbs"
  startPoint    String
  endPoint      String
  monthlyFee    Decimal  @db.Decimal(10, 2)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  institution Institution                  @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicles    TransportVehicle[]
  allocations StudentTransportAllocation[]
  stops       TransportStop[]
  incidents   TransportIncident[]
  attendance  TransportAttendance[]
  monthlyCharges TransportMonthlyCharge[]

  @@map("transport_routes")
}

model TransportVehicle {
  id            String   @id @default(uuid())
  routeId       String
  vehicleNumber String   @unique
  driverName    String
  driverPhone   String
  capacity      Int      @default(30)
  createdAt     DateTime @default(now())

  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  documents TransportVehicleDocument[]
  driverAssignments TransportDriverAssignment[]
  trackingLogs TransportVehicleTrackingLog[]
  incidents TransportIncident[]

  @@map("transport_vehicles")
}

model TransportStop {
  id           String   @id @default(uuid())
  routeId      String
  name         String
  address      String
  sequence     Int
  pickupTime   String?
  dropoffTime  String?
  createdAt    DateTime @default(now())
  route        TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  allocations  StudentTransportAllocation[]
  @@unique([routeId, sequence])
  @@unique([routeId, name])
  @@map("transport_stops")
}

model TransportVehicleDocument {
  id             String   @id @default(uuid())
  vehicleId      String
  documentType   String
  documentNumber String
  expiresAt      DateTime?
  createdAt      DateTime @default(now())
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([vehicleId, expiresAt])
  @@map("transport_vehicle_documents")
}

model TransportDriverAssignment {
  id             String   @id @default(uuid())
  vehicleId      String
  driverName     String
  driverPhone    String
  licenseNumber  String
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  assignedByUserId String
  createdAt      DateTime @default(now())
  vehicle        TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([vehicleId, effectiveFrom, effectiveTo])
  @@map("transport_driver_assignments")
}

model TransportVehicleTrackingLog {
  id                String   @id @default(uuid())
  institutionId     String
  vehicleId         String
  latitude          Float
  longitude         Float
  recordedAt        DateTime
  source            String   @default("MANUAL")
  recordedByUserId  String
  createdAt         DateTime @default(now())
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  vehicle     TransportVehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
  @@index([institutionId, vehicleId, recordedAt])
  @@map("transport_vehicle_tracking_logs")
}

model TransportIncident {
  id                String   @id @default(uuid())
  institutionId     String
  routeId           String
  vehicleId         String?
  studentId         String?
  category          String
  description       String
  occurredAt        DateTime
  status            String   @default("OPEN")
  recordedByUserId  String
  resolvedAt        DateTime?
  createdAt         DateTime @default(now())
  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  route       TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  vehicle     TransportVehicle? @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  student     StudentProfile? @relation(fields: [studentId], references: [id], onDelete: SetNull)
  @@index([institutionId, status, occurredAt])
  @@map("transport_incidents")
}

model StudentTransportAllocation {
  id          String   @id @default(uuid())
  studentId   String   @unique
  routeId     String
  pickupStop  String
  pickupStopId String?
  allocatedAt DateTime @default(now())

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)
  route   TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop    TransportStop? @relation(fields: [pickupStopId], references: [id], onDelete: SetNull)
  attendance TransportAttendance[]
  monthlyCharges TransportMonthlyCharge[]

  @@map("student_transport_allocations")
}

model TransportAttendance {
  id           String   @id @default(uuid())
  institutionId String
  allocationId String
  routeId      String
  studentId    String
  serviceDate  DateTime @db.Date
  status       String   @default("PRESENT")
  remarks      String?
  markedByUserId String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  allocation StudentTransportAllocation @relation(fields: [allocationId], references: [id], onDelete: Cascade)
  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([allocationId, serviceDate])
  @@index([institutionId, routeId, serviceDate])
  @@map("transport_attendance")
}

model TransportMonthlyCharge {
  id           String   @id @default(uuid())
  institutionId String
  allocationId String
  routeId      String
  studentId    String
  period       String   @db.VarChar(7)
  amount       Decimal  @db.Decimal(12, 2)
  createdByUserId String
  createdAt    DateTime @default(now())

  institution Institution @relation(fields: [institutionId], references: [id], onDelete: Cascade)
  allocation StudentTransportAllocation @relation(fields: [allocationId], references: [id], onDelete: Restrict)
  route TransportRoute @relation(fields: [routeId], references: [id], onDelete: Restrict)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  invoice StudentFeeInvoice?

  @@unique([allocationId, period])
  @@index([institutionId, period])
  @@map("transport_monthly_charges")
}

model HostelBlock {
