model CounselingNote {
  id             String   @id @default(uuid())
  caseId         String
  authorUserId   String
  sessionDate    DateTime @default(now())
  encryptedNotes String // Confidential session observations
  actionPlan     String?
  encryptedActionPlan String?
  createdAt      DateTime @default(now())

  counselingCase CounselingCase @relation(fields: [caseId], references: [id], onDelete: Cascade)

