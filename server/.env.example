# =============================================================================
# LMS BACKEND SERVER ENVIRONMENT CONFIGURATION
# =============================================================================

NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1

DATABASE_URL=postgresql://lms:lms_dev_only@localhost:5432/lms?schema=public
DIRECT_URL=postgresql://lms:lms_dev_only@localhost:5432/lms?schema=public

JWT_ACCESS_SECRET=your_dev_jwt_access_secret_min_32_characters_long
JWT_REFRESH_SECRET=your_dev_jwt_refresh_secret_min_32_characters_long
REPORT_CARD_SIGNING_SECRET=your_dev_report_card_signing_secret_min_32_chars
COUNSELING_ENCRYPTION_SECRET=your_dev_counseling_encryption_secret_min_32_chars
FINANCE_ENCRYPTION_SECRET=your_dev_finance_encryption_secret_min_32_chars
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

CLIENT_URL=http://localhost:5173,https://your-lms-domain.vercel.app

STORAGE_PROVIDER=LOCAL
UPLOAD_DIR=./uploads
MAX_FILE_SIZE_MB=10

REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

LOG_LEVEL=info
